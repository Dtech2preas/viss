<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Header Section -->
    <TextView
        android:id="@+id/widgetTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="🌟 JONAS &amp; OWAMI 🌟"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#66FFFFFF"
        android:layout_marginBottom="12dp"
        android:layout_marginLeft="24dp"
        android:layout_marginRight="24dp" />

    <!-- Top Grid Section (Distance, Streak, Mood) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="3"
        android:baselineAligned="false"
        android:layout_marginBottom="12dp">

        <!-- Distance Box -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_weight="1"
            android:background="@drawable/widget_panel_bg"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginRight="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DISTANCE"
                android:textColor="#AEEA00"
                android:textSize="10sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <FrameLayout
                android:layout_width="30dp"
                android:layout_height="1dp"
                android:background="#44FFFFFF"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/widgetDistanceValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/widgetDistanceLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="km"
                android:textColor="#DDDDDD"
                android:textSize="10sp"
                android:textAllCaps="true" />
        </LinearLayout>

        <!-- Streak Box -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_weight="1"
            android:background="@drawable/widget_panel_bg"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginRight="4dp"
            android:layout_marginLeft="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="STREAK"
                android:textColor="#00E5FF"
                android:textSize="10sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <FrameLayout
                android:layout_width="30dp"
                android:layout_height="1dp"
                android:background="#44FFFFFF"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/widgetStreakValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/widgetStreakLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="days"
                android:textColor="#DDDDDD"
                android:textSize="10sp"
                android:textAllCaps="true" />
        </LinearLayout>

        <!-- Mood Box -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_weight="1"
            android:background="@drawable/widget_panel_bg"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginLeft="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MOOD"
                android:textColor="#FF4081"
                android:textSize="10sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <FrameLayout
                android:layout_width="30dp"
                android:layout_height="1dp"
                android:background="#44FFFFFF"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/widgetMoodEmoji"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎭"
                android:textColor="#FFFFFF"
                android:textSize="18sp" />
            <TextView
                android:id="@+id/widgetMoodLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="mood"
                android:textColor="#DDDDDD"
                android:textSize="10sp"
                android:textAllCaps="true" />
        </LinearLayout>
    </LinearLayout>

    <!-- Middle Section: Points & Study -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <TextView
            android:id="@+id/widgetPoints"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="💎 0 PTS 💎"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:gravity="center" />

        <LinearLayout
            android:id="@+id/widgetStudyBtn"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/widget_study_btn_bg"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:gravity="center"
            android:clickable="true">
            <TextView
                android:id="@+id/widgetStudyText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="START STUDY"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#66FFFFFF"
        android:layout_marginBottom="12dp"
        android:layout_marginLeft="24dp"
        android:layout_marginRight="24dp" />

    <!-- Bottom Section: Partner Status -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_panel_bg"
        android:padding="10dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="💫"
            android:textSize="14sp"
            android:layout_marginRight="8dp" />

        <TextView
            android:id="@+id/widgetActivity"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="[Partner] status: --"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textStyle="italic" />
    </LinearLayout>

</LinearLayout>
